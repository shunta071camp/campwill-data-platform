            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule: 3:01 AM JST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, -256]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "executeQuery",
        "projectId": {
          "__rl": true,
          "mode": "list",
          "value": "campwill-realestate",
          "cachedResultName": "campwill-realestate"
        },
        "sqlQuery": "SELECT\n  IFNULL(CAST(UNIX_SECONDS(MAX(posted_at)) AS STRING),\n         CAST(UNIX_SECONDS(TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY)) AS STRING)) AS oldest_ts\nFROM `campwill-realestate.raw.re_slack_messages`",
        "options": {}
      },
      "id": "bq-get-since",
      "name": "BigQuery: Get oldest_ts",
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2,
      "position": [464, -256],
      "credentials": {
        "googleApi": {
          "id": "jDUIvG8csxBsVIGR",
          "name": "Google Service Account (realestate)"
        }
      }
    },
    {
      "parameters": {
        "url": "https://slack.com/api/users.conversations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "types",            "value": "public_channel,private_channel"},
            {"name": "exclude_archived", "value": "true"},
            {"name": "limit",            "value": "200"}
          ]
        },
        "options": {
          "response": {"response": {"responseFormat": "json", "neverError": true}},
          "timeout": 60000
        }
      },
      "id": "http-list-channels",
      "name": "Slack: list channels (property bot joined)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [688, -256],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Q71N5kglIgl3qhFu",
          "name": "Slack Bot (property/read)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nif (!resp || !resp.ok || !Array.isArray(resp.channels)) {\n  throw new Error('Slack users.conversations failed: ' + JSON.stringify(resp).substring(0, 500));\n}\nconst since = $('BigQuery: Get oldest_ts').first().json.oldest_ts;\nreturn resp.channels.map(c => ({\n  json: {\n    channel_id:   c.id,\n    channel_name: c.name,\n    oldest:       since\n  }\n}));\n"
      },
      "id": "code-channel-list",
      "name": "Code: build channel list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [912, -256]
    },
    {
      "parameters": {
        "url": "https://slack.com/api/conversations.history",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "channel", "value": "={{ $json.channel_id }}"},
            {"name": "oldest",  "value": "={{ $json.oldest }}"},
            {"name": "limit",   "value": "200"}
          ]
        },
        "options": {
          "response": {"response": {"responseFormat": "json", "neverError": true}},
          "timeout": 60000,
          "batching": {"batch": {"batchSize": 1, "batchInterval": 1500}}
        }
      },
      "id": "http-history",
      "name": "Slack: conversations.history per channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1136, -256],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Q71N5kglIgl3qhFu",
          "name": "Slack Bot (property/read)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const channelInputs = $('Code: build channel list').all();\nconst histInputs = $input.all();\nconst now = new Date().toISOString();\nconst rows = [];\n\nfor (let i = 0; i < histInputs.length; i++) {\n  const r = histInputs[i].json;\n  if (!r || !r.ok || !Array.isArray(r.messages)) continue;\n  const ch = channelInputs[i]?.json || {};\n  for (const m of r.messages) {\n    if (!m.ts) continue;\n    const ts_sec = parseFloat(m.ts);\n    const posted_at_iso = new Date(ts_sec * 1000).toISOString();\n    const posted_date = new Date((ts_sec * 1000) + 9 * 3600 * 1000).toISOString().substring(0, 10);\n    rows.push({\n      message_ts:      `${ch.channel_id}:${m.ts}`,\n      channel_id:      ch.channel_id,\n      channel_name:    ch.channel_name || null,\n      user_id:         m.user || m.bot_id || null,\n      user_name:       null,\n      text:            (m.text || '').substring(0, 50000),\n      thread_ts:       m.thread_ts || null,\n      is_thread_reply: m.thread_ts != null && m.thread_ts !== m.ts,\n      reactions_json:  Array.isArray(m.reactions) ? JSON.stringify(m.reactions).substring(0, 10000) : null,\n      permalink:       null,\n      posted_at:       posted_at_iso,\n      posted_date:     posted_date,\n      inserted_at:     now\n    });\n  }\n}\n\nreturn rows.map(json => ({ json }));\n"
      },
      "id": "code-transform",
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, -256]
    },
