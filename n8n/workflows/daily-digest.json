      "name": "Gmail: get message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3376,
        -256
      ],
      "alwaysOutputData": true,
      "credentials": {
        "oAuth2Api": {
          "id": "REPLACE_GOOGLE_OAUTH_CRED_ID",
          "name": "Google OAuth2 (readonly)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 各 message の metadata + snippet を整形\nconst gets = $('Gmail: get message').all().map(i => i.json);\nconst out = [];\nfor (const g of gets) {\n  if (!g || !g.id || g.error) continue;\n  const headers = (g.payload && Array.isArray(g.payload.headers)) ? g.payload.headers : [];\n  const h = (n) => {\n    const x = headers.find(z => z.name && z.name.toLowerCase() === n);\n    return x ? x.value : null;\n  };\n  out.push({\n    from: h('from'),\n    subject: h('subject'),\n    date: h('date'),\n    snippet: (g.snippet || '').substring(0, 400),\n  });\n}\nreturn [{ json: { gmail: out } }];\n"
      },
      "id": "code-collect-gmail",
      "name": "Code: collect Gmail",
      "type": "n8n-nodes-base.code",
