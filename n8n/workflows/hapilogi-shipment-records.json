    {
      "parameters": {
        "method": "GET",
        "url": "https://hapilogi.co.jp/hapi/asims/api/shipper/shipmentRecord/get",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "AccessToken",
              "value": "={{ $json.contents.access_token }}"
            }
          ]
