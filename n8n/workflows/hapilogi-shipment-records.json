      "id": "get",
      "name": "logiec: shipmentRecord/get",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// shipmentRecord/get を BQ 行 (明細単位) に整形\n// 差分 API: 前回取得以降に完了した出荷実績のみ返る。0 件は正常 (下流はスキップ)\nconst now = new Date().toISOString();\nconst todayJST = new Date(Date.now() + 9*60*60*1000).toISOString().split('T')[0];\nconst receiptNo = Number($('Code: Extract receipt_no').first().json.receipt_no);\nconst b = $input.first().json || {};\nif (b.status !== 0) throw new Error(`shipmentRecord/get failed: ${JSON.stringify(b).slice(0, 500)}`);\nconst num = v => (v === null || v === undefined || v === '') ? null : Math.trunc(Number(v));\nconst str = v => (v === null || v === undefined || v === '') ? null : String(v);\nconst dt  = v => (typeof v === 'string' && /^\\d{4}-\\d{2}-\\d{2}/.test(v)) ? v.slice(0, 10) : null;\nconst rows = [];\nfor (const rec of (Array.isArray(b.contents) ? b.contents : [])) {\n  const h = rec.header || {};\n  const invoices = [];\n  for (let i = 1; i <= 30; i++) { const v = h['invoice_no' + i]; if (v) invoices.push(String(v)); }\n  for (const d of (Array.isArray(rec.details) ? rec.details : [])) {\n    rows.push({ json: {\n      fetched_date: todayJST,\n      receipt_no: receiptNo,\n      order_management_no: str(h.order_management_no),\n      order_no: str(h.order_no),\n      order_no_sub: str(h.order_no_sub),\n      estimated_shipping_date: dt(h.estimated_shipping_date),\n      shipment_date: dt(h.shipment_date),\n      total_units: num(h.total_units),\n      invoice_no: invoices[0] || null,\n      invoice_nos: invoices.length ? invoices.join(',') : null,\n      row_no: num(d.row_no),\n      item_code: str(d.item_code),\n      inventory_type: num(d.inventory_type),\n      lot_no: str(d.lot_no),\n      inbound_date: dt(d.inbound_date),\n      expiration_date: dt(d.expiration_date),\n      shipping_instruction_quantity: num(d.shipping_instruction_quantity),\n      shipment_quantity: num(d.shipment_quantity),\n      raw_payload: JSON.stringify({ header: h, detail: d }),\n      inserted_at: now\n    }});\n  }\n}\nreturn rows;\n"
      },
      "id": "flatten",
      "name": "Code: Flatten to BQ Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        200
      ]
    },
