    {
      "parameters": {
        "method": "GET",
        "url": "https://hapilogi.co.jp/hapi/asims/api/shipper/shipmentRecord/inquireStatus",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
