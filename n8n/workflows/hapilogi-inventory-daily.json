          "name": "はぴロジ API Login"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://hapilogi.co.jp/hapi/asims/api/shipper/inventory/createRequiredData",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "AccessToken",
              "value": "={{ $json.contents.access_token }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "shipper_id",
              "value": "={{ $('Config').first().json.shipper_id }}"
            },
            {
              "name": "sales_channel_id",
              "value": "={{ $('Config').first().json.sales_channel_id }}"
            },
            {
              "name": "aggregation_type",
              "value": "ByProduct"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "create",
      "name": "logiec: inventory/createRequiredData",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// createRequiredData のレスポンスから receipt_no を取り出す\nconst b = $input.first().json || {};\nconst receiptNo = b?.contents?.receipt_no;\nif (b.status !== 0 || !receiptNo) {\n  throw new Error(`createRequiredData failed: ${JSON.stringify(b).slice(0, 500)}`);\n}\nreturn [{ json: { receipt_no: receiptNo } }];\n"
      },
      "id": "extract-receipt",
      "name": "Code: Extract receipt_no",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "amount": 20
      },
      "id": "wait",
      "name": "Wait 20s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1000,
        300
      ],
      "webhookId": "hapilogi-inventory-wait"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hapilogi.co.jp/hapi/api/authentication",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "auth-2",
      "name": "Auth #2 (for status)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "REPLACE_ME_HAPILOGI_CRED_ID",
          "name": "はぴロジ API Login"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://hapilogi.co.jp/hapi/asims/api/shipper/inventory/inquireStatus",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "AccessToken",
              "value": "={{ $json.contents.access_token }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "receipt_no",
              "value": "={{ $('Code: Extract receipt_no').first().json.receipt_no }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "status",
      "name": "logiec: inventory/inquireStatus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 作成状況を判定。トークンは使い捨てなので毎ループ Auth からやり直す\n// Accepted / Processing → 待機して再問合せ\n// DataCreationCompleted / ExportComplete → get へ\n// DataCreationError / ExportError → 失敗 (errorWorkflow へ)\nconst b = $input.first().json || {};\nconst st = b?.contents?.status;\nconst maxPolls = Number($('Config').first().json.max_polls) || 30;\nconst poll = $runIndex + 1;\nif (b.status !== 0) throw new Error(`inquireStatus failed: ${JSON.stringify(b).slice(0, 500)}`);\nif (st === 'DataCreationError' || st === 'ExportError') {\n  throw new Error(`hapilogi export ${st}: ${JSON.stringify(b.contents?.errors || []).slice(0, 500)}`);\n}\nconst ready = st === 'DataCreationCompleted' || st === 'ExportComplete';\nif (!ready && poll >= maxPolls) throw new Error(`hapilogi export timeout after ${poll} polls (last status=${st})`);\nreturn [{ json: { ready, export_status: st, poll } }];\n"
      },
      "id": "judge",
      "name": "Code: Judge Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-ready",
              "leftValue": "={{ $json.ready }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-ready",
      "name": "IF: Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1800,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hapilogi.co.jp/hapi/api/authentication",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
