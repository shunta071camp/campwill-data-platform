    {
      "parameters": {
        "method": "GET",
        "url": "https://hapilogi.co.jp/hapi/asims/api/shipper/inventory/get",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "AccessToken",
              "value": "={{ $json.contents.access_token }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "receipt_no",
              "value": "={{ $('Code: Extract receipt_no').first().json.receipt_no }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "get",
      "name": "logiec: inventory/get",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// inventory/get (ByProduct) を BQ 行に整形\n// 仕様書の例では数量が文字列で返るケースがあるので Number() で正規化\nconst now = new Date().toISOString();\nconst todayJST = new Date(Date.now() + 9*60*60*1000).toISOString().split('T')[0];\nconst receiptNo = Number($('Code: Extract receipt_no').first().json.receipt_no);\nconst b = $input.first().json || {};\nif (b.status !== 0) throw new Error(`inventory/get failed: ${JSON.stringify(b).slice(0, 500)}`);\nconst items = Array.isArray(b.contents) ? b.contents : [];\nif (items.length === 0) throw new Error('inventory/get returned 0 items (要確認: shipper_id / sales_channel_id)');\nconst num = v => (v === null || v === undefined || v === '') ? null : Math.trunc(Number(v));\nreturn items.map(it => ({ json: {\n  snapshot_date:         todayJST,\n  item_code:             String(it.item_code || ''),\n  inventory_type:        num(it.inventory_type),\n  gross_inventory:       num(it.gross_inventory),\n  allocatable_inventory: num(it.allocatable_inventory),\n  receipt_no:            receiptNo,\n  raw_payload:           JSON.stringify(it),\n  inserted_at:           now\n}}));\n"
      },
      "id": "flatten",
      "name": "Code: Flatten to BQ Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        200
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "insert",
        "projectId": {
          "__rl": true,
          "mode": "list",
          "value": "campwill-ec",
          "cachedResultName": "campwill-ec"
        },
        "datasetId": {
          "__rl": true,
          "mode": "list",
          "value": "raw",
          "cachedResultName": "raw"
        },
        "tableId": {
          "__rl": true,
          "mode": "list",
          "value": "ec_hapilogi_inventory_daily",
          "cachedResultName": "ec_hapilogi_inventory_daily"
        },
        "options": {}
      },
      "id": "bq-insert",
      "name": "BigQuery: Insert raw.ec_hapilogi_inventory_daily",
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2,
      "position": [
        2600,
        200
      ],
      "credentials": {
        "googleApi": {
          "id": "WCCQWQHLcPs05bNu",
          "name": "Google Service Account account（EC）"
        }
      }
    }
