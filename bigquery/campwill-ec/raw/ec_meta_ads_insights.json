[
  {"name": "DateStart",            "type": "DATE",       "mode": "REQUIRED", "description": "日付 (JST 解釈、insights の date_start)"},
  {"name": "AdAccountId",          "type": "STRING",     "mode": "REQUIRED", "description": "Ad account ID (数字のみ、act_ prefix なし)"},
  {"name": "CampaignId",           "type": "STRING",     "mode": "NULLABLE", "description": "キャンペーンID"},
  {"name": "CampaignName",         "type": "STRING",     "mode": "NULLABLE", "description": "キャンペーン名"},
  {"name": "AdSetId",              "type": "STRING",     "mode": "NULLABLE", "description": "広告セットID"},
  {"name": "AdSetName",            "type": "STRING",     "mode": "NULLABLE", "description": "広告セット名"},
  {"name": "AdId",                 "type": "STRING",     "mode": "REQUIRED", "description": "広告ID (主キー2)"},
  {"name": "AdName",               "type": "STRING",     "mode": "NULLABLE", "description": "広告名"},
  {"name": "Objective",            "type": "STRING",     "mode": "NULLABLE", "description": "キャンペーン目的 (LINK_CLICKS / CONVERSIONS 等)"},
  {"name": "BuyingType",           "type": "STRING",     "mode": "NULLABLE", "description": "購入タイプ (AUCTION 等)"},
  {"name": "Impressions",          "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "インプレッション数"},
  {"name": "Clicks",               "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "クリック数 (all clicks)"},
  {"name": "Spend",                "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "広告費 (アカウント通貨、JPY の場合は円)"},
  {"name": "Reach",                "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "リーチ (ユニークユーザー数)"},
  {"name": "Frequency",            "type": "FLOAT",      "mode": "NULLABLE", "description": "配信頻度 (impressions / reach)"},
  {"name": "CPC",                  "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "Cost per Click"},
  {"name": "CPM",                  "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "Cost per Mille (1000 impressions)"},
  {"name": "CPP",                  "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "Cost per 1000 reached people"},
  {"name": "CTR",                  "type": "FLOAT",      "mode": "NULLABLE", "description": "Click through rate (%)"},
  {"name": "UniqueClicks",         "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "ユニーククリック数"},
  {"name": "UniqueCTR",            "type": "FLOAT",      "mode": "NULLABLE", "description": "Unique CTR (%)"},
  {"name": "InlineLinkClicks",     "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "リンククリック数 (inline)"},
  {"name": "InlinePostEngagement", "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "投稿エンゲージメント (inline)"},
  {"name": "OutboundClicks",       "type": "BIGNUMERIC", "mode": "NULLABLE", "description": "アウトバウンドクリック数 (SUM of outbound_clicks[].value)"},
  {"name": "Level",                "type": "STRING",     "mode": "NULLABLE", "description": "集計レベル (常に 'ad')"},
  {"name": "AccountCurrency",      "type": "STRING",     "mode": "NULLABLE", "description": "アカウント通貨 (JPY 等)"},
  {"name": "inserted_at",          "type": "TIMESTAMP",  "mode": "REQUIRED", "description": "BQ 投入日時"}
]
