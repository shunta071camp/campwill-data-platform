[
  {"name": "initiative_id",     "type": "STRING",    "mode": "REQUIRED", "description": "施策ID (主キー、Claude が生成 or 既存 ID 流用)"},
  {"name": "detected_at",       "type": "TIMESTAMP", "mode": "REQUIRED", "description": "AI 検出日時"},
  {"name": "action_type",       "type": "STRING",    "mode": "NULLABLE", "description": "create / append_source (重複施策 merge 用)"},
  {"name": "source",            "type": "STRING",    "mode": "NULLABLE", "description": "slack / backlog"},
  {"name": "source_id",         "type": "STRING",    "mode": "NULLABLE", "description": "元 message_ts or issue_id"},
  {"name": "source_url",        "type": "STRING",    "mode": "NULLABLE", "description": "元 message permalink or backlog URL"},
  {"name": "additional_source_ids","type":"STRING",  "mode": "NULLABLE", "description": "append_source 時の追加 source_id 配列 (JSON 文字列)"},
  {"name": "category",          "type": "STRING",    "mode": "NULLABLE", "description": "物件 / 集客 / 営業 / SEO / その他"},
  {"name": "title",             "type": "STRING",    "mode": "NULLABLE", "description": "施策タイトル"},
  {"name": "description",       "type": "STRING",    "mode": "NULLABLE", "description": "施策内容 (PII 除去済)"},
  {"name": "start_date",        "type": "DATE",      "mode": "NULLABLE", "description": "実施開始日"},
  {"name": "end_date",          "type": "DATE",      "mode": "NULLABLE", "description": "実施終了日"},
  {"name": "target_metric",     "type": "STRING",    "mode": "NULLABLE", "description": "inquiry / deal / seo / other (不動産用 3 種限定)"},
  {"name": "related_property",  "type": "STRING",    "mode": "NULLABLE", "description": "関連物件 (property_id or 物件名)"},
  {"name": "related_channel",   "type": "STRING",    "mode": "NULLABLE", "description": "関連チャネル (suumo / homes / organic 等)"},
  {"name": "confidence",        "type": "STRING",    "mode": "NULLABLE", "description": "high / medium / low"},
  {"name": "confidence_score",  "type": "FLOAT",     "mode": "NULLABLE", "description": "0-1 数値"},
  {"name": "raw_payload",       "type": "STRING",    "mode": "NULLABLE", "description": "Claude API 生レスポンス"},
  {"name": "parse_error_flag",  "type": "BOOL",      "mode": "NULLABLE", "description": "JSON parse 失敗時 TRUE"},
  {"name": "inserted_at",       "type": "TIMESTAMP", "mode": "REQUIRED", "description": "BigQuery 挿入日時"}
]
