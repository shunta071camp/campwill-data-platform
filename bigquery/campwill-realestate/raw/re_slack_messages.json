[
  {"name": "message_ts",      "type": "STRING",    "mode": "REQUIRED", "description": "主キー: <channel_id>:<ts> 連結"},
  {"name": "channel_id",      "type": "STRING",    "mode": "REQUIRED", "description": "Slack channel ID (C0XXXX)"},
  {"name": "channel_name",    "type": "STRING",    "mode": "NULLABLE", "description": "チャネル名 (#general 等)"},
