  {"name": "text",            "type": "STRING",    "mode": "NULLABLE", "description": "メッセージ本文 (markdown 含む)"},
  {"name": "thread_ts",       "type": "STRING",    "mode": "NULLABLE", "description": "スレッド親 message の ts"},
